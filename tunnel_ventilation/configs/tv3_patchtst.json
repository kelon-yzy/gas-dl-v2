{
  "dataset_dir": "data/tv3-formal",
  "output_dir": "outputs/tv3_patchtst",
  "model": "patchtst",
  "model_kwargs": {
    "patch_len": 16,
    "stride": 8,
    "d_model": 64,
    "nhead": 4,
    "num_layers": 2,
    "dim_feedforward": 128,
    "dropout": 0.1,
    "pooling": "attention"
  },
  "modalities": "slow",
  "epochs": 80,
  "batch_size": 16,
  "num_workers": 2,
  "pin_memory": true,
  "persistent_workers": false,
  "prefetch_factor": 2,
  "seed": 20260704,
  "device": "cuda",
  "loss": {
    "name": "weighted_component_mse",
    "weighting": "inverse_train_var",
    "component_count": 3
  },
  "optimizer": "adamw",
  "lr": 0.001,
  "weight_decay": 0.0001,
  "grad_clip_norm": 1.0,
  "eval_splits": "val,test",
  "checkpoint_name": "checkpoint.pt",
  "early_stopping": {
    "enabled": true,
    "monitor": "val_loss",
    "patience": 15,
    "min_delta": 0.0,
    "mode": "min"
  },
  "scheduler": {
    "name": "reduce_on_plateau",
    "factor": 0.5,
    "patience": 8,
    "min_lr": 1e-6
  },
  "amp": {
    "enabled": false,
    "dtype": "float16"
  },
  "performance": {
    "cudnn_benchmark": true,
    "tf32": true,
    "compile": false,
    "compile_mode": "default"
  },
  "progress": {
    "enabled": true,
    "stdout": true,
    "jsonl": true,
    "jsonl_name": "metrics_live.jsonl"
  }
}
