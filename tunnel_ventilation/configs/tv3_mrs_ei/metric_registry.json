      "condition": "all_gates_passed",
      "allowed_next_stage": "MEI-2_robust_design",
      "registered_sparse_simulation_generation_review_eligible": true
    },
    "mei1_inconclusive_forward_model": {
      "condition": "any_blocker_present",
      "allowed_next_stage": null
    },
    "mei1_fixed_k4_retained": {
      "condition": "no_physics_blocker_and_all_k4_designs_within_delta_practical",
      "allowed_next_stage": "MEI-3_varpro_audit",
      "frozen_design": "D0_fixed_k4_25_63_100_200_khz",
      "skip_stage": "MEI-2_robust_design",
      "registered_sparse_simulation_generation_review_eligible": false
    },
    "mei3_varpro_supported": {
      "condition": "s2_passes_solver_gate",
      "mei4_baseline": "S2"
    },
    "mei3_varpro_not_applicable": {
      "condition": "linear_structure_unavailable",
      "mei4_baseline": "S1"
    },
    "mei6_eligibility": {
      "require_stable_learnable_residual_evidence": true,
      "otherwise": "np_vpnet_forbidden"
    }
  },
