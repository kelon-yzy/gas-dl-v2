  "c0_contradiction_disposition": [
    {
      "id": "contradiction_1_m2b_unreachable",
      "finding": "C0 的 mc_protocol 中 sbc.methods 与 ppc.methods 均为 [M1, M1b, M2]，不含 M2b；verdict_state_machine 却要求 M1_or_M2_or_M2b_passes_complete_calibration_gate。因此 mrs_ei_mei4_c4.py 的 _m2b_gate() 把 M2b 的 complete_calibration_gate_passed 硬编码为 False。",
      "consequence": "叠加 C2 已确定的 M1/M1b 覆盖失败，T1 在 C2 结束时即注定为 true，mei4_deterministic_posterior_retained 结构上不可达。",
      "disposition": "record_as_contract_defect",
      "disposition_detail": "本次收尾不补登记 M2b 的 SBC/PPC（那属于 P-A 路径）。只把该缺陷登记为契约设计问题并写进论文局限，明确它不是实验结果。",
      "publication_requirement": "论文必须声明：目标 verdict 的不可达来自冻结契约的方法登记遗漏，与后验方法本身的性能无关。"
    },
    {
      "id": "contradiction_2_t4_circular",
      "finding": "T4 的语义是「M2b 必要但成本超出登记预算」，用途是跳过 M2b；但实现从实测 m2b_report['cost']['forward_calls'] 读值判定，要求 M2b 先完整执行。",
      "consequence": "按 B4 的 S1 平均 forward_calls=395 事前估算，M2b 登记规模需 1296 × 200 × 395 ≈ 1.02e8 次前向调用，是 C0 登记预算 1.0e6 的约 102 倍，T4 在 C3 启动前即已成立。",
      "disposition": "record_as_contract_defect",
      "disposition_detail": "本次收尾不运行 M2b，T4 不触发任何分支。若未来重启，T4 必须改为事前预算估算。",
      "estimated_forward_calls": 102000000,
      "registered_budget_forward_calls": 1000000
    },
    {
      "id": "contradiction_3_prior_spec_mismatch",
      "finding": "C0 的 method_input_policy.allowed_assets 只含干扰参数标定先验，无组分先验，因此 M1/M1b/M2 在单纯形上使用平坦组分先验；而登记观测由受约束 LHS 生成（x_CO2 0.03–5.00%、x_O2 18.00–21.20%）。",
      "consequence": "§0.1 的区间超量程与 96.9% 切空间质量出域直接由平坦先验产生。跨规格比较绝对区间宽度无效。",
      "disposition": "record_and_constrain_reporting",
      "disposition_detail": "本次收尾不做跨规格比较。所有区间宽度数值在报告时必须显式标注「平坦单纯形组分先验规格下」。若未来重启，须先择一处置（把登记 LHS 组分域纳入后验定义域，或把主指标改为先验宽度到后验宽度的收缩比），且必须与主指标定义在同一次契约冻结中完成。",
      "reporting_constraint": "禁止把本线的绝对区间宽度与任何使用真实生成先验的方法（含 CC-SBI）直接比较。"
    }
  ],
