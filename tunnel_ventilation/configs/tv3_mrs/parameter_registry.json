  "dispersion_forward_model": {
    "name": "single_relaxation_sum_v1",
    "equations": {
      "c_f": "c_eq * (1 + sum_i (Delta_c_i/c_eq) * f^2/(f^2+f_r_i^2))",
      "alpha_f": "alpha_classical(f) + sum_i Lorentzian_i(f; alpha_lambda_max_i, f_r_i)"
    },
    "explicit_non_goals": [
      "no_full_coupled_relaxation_matrix_dain_lueptow",
      "no_change_to_hidden_sound_speed_v2",
      "no_change_to_hidden_attenuation_v2"
    ],
    "source": "engineering_scenario",
    "notes": "MRS-1 实现；近似误差边界若影响 MRS-2 判定再立 MRS-1b。"
  },
  "storage_policy": {
