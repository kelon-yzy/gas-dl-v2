    "notes": "MRS v1 基线 flow=0；扰动登记复用 S 线与 v1 registry。组分与 7 慢通道复用基 schema。",
    "source": "implemented_physics",
    "ref": "tv3/sim/core/tunnel_ventilation_schema.py"
  },
  "sampling_domain": {
    "T_C": {"min": 15.0, "max": 35.0},
    "H_RH": {"min": 20.0, "max": 80.0},
    "P_MPa": {"min": 0.10, "max": 0.709},
    "L_m": {"min": 0.20, "max": 0.30},
    "x_O2": {"min": 18.0, "max": 21.2},
    "x_CO2": {"min": 0.03, "max": 5.0},
    "source": "implemented_physics",
    "ref": "tv3/sim/generation/tunnel_ventilation/conditions.py"
  },
  "bass_relaxation_frequencies": {
    "name": "bass_1990_iso9613_1",
    "refs": [
      "doi:10.1121/1.400176",
      "doi:10.1121/1.412989"
    ],
    "T0_K": 293.15,
    "P0_atm": 1.0,
    "h_definition": "water_vapor_mole_percent",
    "h_source_fn": "h2o_mole_percent_from_rh",
    "f_r_o2_hz_per_atm": {
      "formula": "(P/P0) * [24 + 4.04e4 * h * (0.02 + h) / (0.391 + h)]",
      "coefficients": {
        "dry_offset_hz": 24.0,
        "humidity_scale": 40400.0,
        "humidity_num_offset": 0.02,
        "humidity_den_offset": 0.391
      },
      "anchors": {
        "h0": {"h": 0.0, "P_atm": 1.0, "expected_hz": 24.0},
        "h1_pct": {"h": 1.0, "P_atm": 1.0, "expected_hz": 29649.0, "tolerance_rel": 0.01}
      },
      "source": "literature_bound"
    },
    "f_r_n2_hz_per_atm": {
      "formula": "(P/P0) * (T/T0)^(-1/2) * [9 + 280*h*exp(-4.17*((T/T0)^(-1/3) - 1))]",
      "coefficients": {
        "dry_offset_hz": 9.0,
        "humidity_scale": 280.0,
        "temp_exp_coeff": 4.17
      },
      "anchors": {
        "h0_20C": {"h": 0.0, "T_C": 20.0, "P_atm": 1.0, "expected_hz": 9.0},
        "h1_20C": {"h": 1.0, "T_C": 20.0, "P_atm": 1.0, "expected_hz": 289.0, "tolerance_rel": 0.02}
      },
      "source": "literature_bound"
    },
    "source": "literature_bound",
    "notes": "Bass 1990 / ISO 9613-1 全式；湿度催化非对称是 O₂↔N₂ 可分机制之一。"
  },
  "vibrational_heat_capacity": {
    "theta_vib_K": {
      "O2": 2270.0,
      "N2": 3390.0,
      "CO2_bending": 960.0
    },
    "C_vib_over_R": {
      "formula": "(theta/T)^2 * exp(theta/T) / (exp(theta/T) - 1)^2",
      "anchors_300K": {
        "O2": {"expected": 0.029, "tolerance_rel": 0.05},
        "N2": {"expected": 0.0016, "tolerance_rel": 0.05}
      }
    },
    "dispersion_step": {
      "formula_small_Cvib": "Delta_c / c_eq ≈ ((gamma-1)^2 / (2*gamma)) * (C_vib/R)",
      "pure_gas_anchors_300K_m_per_s": {
        "O2": {"expected": 0.5, "tolerance_rel": 0.30},
        "N2": {"expected": 0.03, "tolerance_rel": 0.30}
      },
      "notes": "容差来自综述 §A3(c) 手算链；MRS-1 单元测试确认。"
    },
    "kramers_kronig_single_relaxation": {
      "constraint": "alpha_lambda_max_i = pi * Delta_c_i / c_eq",
      "notes": "单弛豫加和近似内部约束；不做完整耦合弛豫矩阵。"
    },
    "legacy_v2_empirical_intensity": {
      "alpha_lambda_max_co2": 0.12,
      "alpha_lambda_max_n2": 0.004,
      "alpha_lambda_max_o2": 0.0,
      "alpha_lambda_max_h2o": 0.01,
      "notes": "仅对照；MRS 强度由 C_vib 推导，不改 hidden_attenuation_v2。",
      "source": "implemented_physics",
      "ref": "tv3/sim/generation/tunnel_ventilation/acoustic_physics.py"
    },
    "source": "literature_bound",
    "refs": [
      "docs/references/声速法_N2-O2辨识_深度学习突破路径_综述.md §A3",
      "doi:10.1121/1.400176"
    ]
  },
  "frequency_set": {
    "K": 8,
    "f_hz": [10000.0, 16000.0, 25000.0, 40000.0, 63000.0, 100000.0, 160000.0, 200000.0],
    "grid": "log_approx_1-2-2.5-4-6.3",
    "design_rule": "Zhu_2017a_2N+1_with_N_le_3_active_relaxations",
    "sensitivity_subsets_K": [4, 6, 8],
    "geometry_floor_hz": {
      "value": 15000.0,
      "rule": "path_length_ge_approx_10_wavelengths_at_L_0.2_to_0.3_m",
      "notes": "10 kHz 处 L/λ≈6–9 属边界；死角在 Fisher 热力图显式覆盖。",
      "source": "engineering_scenario"
    },
    "source": "engineering_scenario",
    "notes": "MRS-0 冻结基线；MRS-2 对 K=4/6/8 子集做敏感性。"
  },
  "burst_schedule": {
    "rule": "burst_duration_well_below_nominal_TOF_approx_725_us",
    "per_frequency_cycles": {
      "10000": 2,
      "16000": 3,
      "25000": 4,
      "40000": 5,
      "63000": 6,
      "100000": 8,
      "160000": 8,
      "200000": 8
