{
  "dataset_dir": "data/tv3-formal-6000",
  "output_dir": "outputs/tv3_r5/tabpfn_observed",
  "feature_set": "physics_stats",
  "head": "tabpfn",
  "feature_builder": "d0_observed_physics_stats_v1",
  "include_slow": true,
  "physics_arrays": [
    "ultrasonic_tof_observed_s",
    "ultrasonic_peak_index",
    "ultrasonic_sound_speed_estimated_m_per_s",
    "ultrasonic_tof_quality",
    "ultrasonic_tof_accepted"
  ],
  "sequence_statistics": [
    "mean",
    "std",
    "min",
    "max",
    "range",
    "first",
    "last",
    "delta",
    "slope"
  ],
  "phase_windows": [
    "baseline",
    "exposure",
    "steady",
    "recovery"
  ],
  "early_fractions": [
    0.25,
    0.5,
    0.75
  ],
  "eval_splits": [
    "val",
    "test",
    "extrapolation"
  ],
  "device": "cuda"
}
