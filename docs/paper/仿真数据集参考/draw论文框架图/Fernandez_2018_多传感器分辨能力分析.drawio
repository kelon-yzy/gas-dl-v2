<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="fernandez2018" name="Fernandez 2018 分辨能力分析">
    <mxGraphModel dx="1516" dy="916" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#000000;" value="Fernandez 等（2018）多传感器阵列分辨能力仿真与 PCA 分析流程" vertex="1">
          <mxGeometry height="35" width="650" x="150" y="5" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="设定两种气体浓度范围&#xa;C₁、C₂：100–1000 ppm" vertex="1">
          <mxGeometry height="70" width="260" x="300" y="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="Clifford–Tuma 金属氧化物传感器模型&#xa;由气体浓度计算传感器理论响应" vertex="1">
          <mxGeometry height="80" width="360" x="250" y="170" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="设定灵敏度矩阵 K&#xa;Kᵢⱼ：第 i 个传感器对第 j 种气体的灵敏度" vertex="1">
          <mxGeometry height="85" width="360" x="250" y="310" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="连续改变灵敏度矩阵&#xa;高互补 → 部分互补 → 两传感器完全相同" vertex="1">
          <mxGeometry height="85" width="360" x="250" y="455" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="生成 2001 种虚拟传感器阵列" vertex="1">
          <mxGeometry height="65" width="280" x="290" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="对每种阵列生成传感器响应&#xa;X₁、X₂" vertex="1">
          <mxGeometry height="65" width="280" x="290" y="710" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="加入随机测量噪声&#xa;Gaussian Noise（高斯噪声）" vertex="1">
          <mxGeometry height="70" width="280" x="290" y="820" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="计算传感器响应空间 Vₛ&#xa;Sensor Space Volume（响应空间面积/体积）" vertex="1">
          <mxGeometry height="80" width="360" x="250" y="950" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="计算噪声空间 Vₙ&#xa;Noise Volume（单次测量的不确定范围）" vertex="1">
          <mxGeometry height="80" width="360" x="250" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="计算分辨能力&#xa;Resolving Power ≈ Vₛ / Vₙ" vertex="1">
          <mxGeometry height="75" width="310" x="275" y="1215" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;strokeWidth=1.5;" value="评价传感器阵列设计&#xa;选择性、互补性、冗余度、抗噪能力" vertex="1">
          <mxGeometry height="80" width="340" x="260" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=12;strokeWidth=1;dashed=1;" value="高互补阵列&#xa;不同传感器响应方向明显不同&#xa;→ Vₛ 较大" vertex="1">
          <mxGeometry height="90" width="240" x="665" y="430" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=12;strokeWidth=1;dashed=1;" value="高冗余阵列&#xa;两个传感器响应近似共线&#xa;→ Vₛ 接近 0" vertex="1">
          <mxGeometry height="90" width="240" x="665" y="535" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=12;strokeWidth=1;dashed=1;" value="噪声增大&#xa;→ Vₙ 增大&#xa;→ 分辨能力下降" vertex="1">
          <mxGeometry height="85" width="240" x="720" y="1077.5" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=12;strokeWidth=1;dashed=1;" value="高维真实传感器数据&#xa;先尺度统一，再用 PCA 降维&#xa;再计算凸包面积/体积" vertex="1">
          <mxGeometry height="105" width="245" x="620" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=12;strokeWidth=1;dashed=1;" value="实际验证：两只商业 MOX 传感器&#xa;完整温度调制响应共 200 维&#xa;PCA 降到低维后计算分辨能力" vertex="1">
          <mxGeometry height="115" width="245" x="900" y="1195" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=12;strokeWidth=1;dashed=1;" value="局部分区分析&#xa;不同浓度/湿度区域分别计算&#xa;避免全局指标掩盖局部不可辨识" vertex="1">
          <mxGeometry height="105" width="240" x="680" y="1337.5" as="geometry" />
        </mxCell>
