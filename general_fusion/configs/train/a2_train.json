{
  "schema_version": "gf-a2-train-1",
  "seeds": [17, 29, 43, 71, 101],
  "optimizer": {
    "name": "LBFGS",
    "learning_rate": 1.0,
    "weight_decay": 0.0,
    "max_iter": 10,
    "history_size": 50
  },
  "loss": {
    "name": "mse",
    "target_scale": [100.0, 100.0, 100.0]
  },
  "max_epochs": 100,
  "early_stopping": {
    "enabled": true,
    "monitor": "val_macro_RNMAE",
    "patience": 40,
    "selection_split": "val",
    "test_access": "forbidden"
  },
  "search": {
    "trials_per_candidate": 2,
    "selection_split": "val",
    "allowed_splits": ["train", "inner_oof", "val"]
  },
  "capacity_presets": [
    {
      "name": "small",
      "encoder_hidden_dim": 16,
      "fusion_hidden_dim": 16,
      "head_hidden_dim": 16
    },
    {
      "name": "large",
      "encoder_hidden_dim": 32,
      "fusion_hidden_dim": 32,
      "head_hidden_dim": 32
    }
  ],
  "parameter_match_tolerance": 0.1
}
