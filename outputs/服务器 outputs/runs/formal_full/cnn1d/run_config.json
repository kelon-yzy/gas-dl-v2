{
  "dataset_dir": "data/wv4-formal-hitran-standard-6000",
  "output_dir": "outputs/runs/formal_full/cnn1d",
  "model_config": {
    "name": "cnn1d",
    "in_channels": 3008,
    "out_dim": 4
  },
  "input_format": "NCT",
  "modalities": [
    "slow",
    "ultrasonic",
    "fiber_mic"
  ],
  "scaler_path": null,
  "target_transform": null,
  "resolved_target_transform": null,
  "epochs": 300,
  "batch_size": 16,
  "num_workers": 8,
  "pin_memory": true,
  "persistent_workers": true,
  "prefetch_factor": 2,
  "seed": 20260603,
  "device": "cuda",
  "loss": "mse",
  "optimizer": {
    "name": "adamw",
    "lr": 0.001,
    "weight_decay": 0.0
  },
  "early_stopping": {
    "enabled": true,
    "monitor": "val_loss",
    "patience": 20,
    "min_delta": 0.0,
    "mode": "min"
  },
  "scheduler": {
    "name": "reduce_on_plateau",
    "factor": 0.5,
    "patience": 8,
    "min_lr": 1e-06
  },
  "amp": {
    "enabled": true,
    "dtype": "float16"
  },
  "progress": {
    "enabled": true,
    "stdout": true,
    "jsonl": true,
    "jsonl_name": "metrics_live.jsonl"
  },
  "eval_splits": [
    "val",
    "test",
    "extrapolation"
  ]
}