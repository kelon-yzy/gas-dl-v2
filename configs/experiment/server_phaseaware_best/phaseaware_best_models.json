{
  "experiment_name": "phaseaware_best_models",
  "dataset_dir": "data/wv4-formal-hitran-standard-6000",
  "output_root": "outputs",
  "seed": 20260603,
  "device": "cuda",
  "eval_splits": ["val", "test", "extrapolation"],
  "training": {
    "epochs": 300,
    "batch_size": 16,
    "num_workers": 8,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "optimizer": "adamw",
    "lr": 0.001,
    "weight_decay": 0.0,
    "loss": "mse",
    "early_stopping": {
      "enabled": true,
      "monitor": "val_loss",
      "patience": 20,
      "min_delta": 0.0,
      "mode": "min"
    },
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 8,
      "min_lr": 0.000001
    },
    "amp": {
      "enabled": true,
      "dtype": "float16"
    },
    "progress": {
      "enabled": true,
      "stdout": true,
      "jsonl": true,
      "jsonl_name": "metrics_live.jsonl"
    }
  },
  "ml_runs": [
    {
      "name": "ridge_all_modalities",
      "model": {"name": "ridge", "alpha": 1.0},
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "protocol": false
    },
    {
      "name": "ridge_all_modalities_phase_exposure",
      "model": {"name": "ridge", "alpha": 1.0},
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "protocol": false,
      "window": {"kind": "phase", "value": "exposure"}
    },
    {
      "name": "ridge_all_modalities_phase_recovery",
      "model": {"name": "ridge", "alpha": 1.0},
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "protocol": false,
      "window": {"kind": "phase", "value": "recovery"}
    },
    {
      "name": "ridge_all_modalities_early_050",
      "model": {"name": "ridge", "alpha": 1.0},
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "protocol": false,
      "window": {"kind": "early", "value": 0.5}
    },
    {
      "name": "ridge_all_modalities_early_075",
      "model": {"name": "ridge", "alpha": 1.0},
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "protocol": false,
      "window": {"kind": "early", "value": 0.75}
    }
  ],
  "dl_runs": [
    {
      "name": "cnn1d_tcn_fusion",
      "model": "cnn1d_tcn_fusion",
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "model_kwargs": {}
    },
    {
      "name": "cnn1d_tcn_fusion_phase_exposure",
      "model": "cnn1d_tcn_fusion",
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "model_kwargs": {},
      "window": {"kind": "phase", "value": "exposure"}
    },
    {
      "name": "cnn1d_tcn_fusion_phase_recovery",
      "model": "cnn1d_tcn_fusion",
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "model_kwargs": {},
      "window": {"kind": "phase", "value": "recovery"}
    },
    {
      "name": "cnn1d_tcn_fusion_early_050",
      "model": "cnn1d_tcn_fusion",
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "model_kwargs": {},
      "window": {"kind": "early", "value": 0.5}
    },
    {
      "name": "cnn1d_tcn_fusion_early_075",
      "model": "cnn1d_tcn_fusion",
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "model_kwargs": {},
      "window": {"kind": "early", "value": 0.75}
    }
  ]
}
