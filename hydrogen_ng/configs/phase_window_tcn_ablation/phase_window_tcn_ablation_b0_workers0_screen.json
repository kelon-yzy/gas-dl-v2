{
  "experiment_name": "phase_window_tcn_ablation_b0_workers0_screen",
  "dataset_dir": "data/wv4-formal-hitran-standard-6000",
  "output_root": "outputs",
  "seed": 20260615,
  "device": "cuda",
  "eval_splits": ["val", "test", "extrapolation"],
  "training": {
    "epochs": 80,
    "batch_size": 16,
    "num_workers": 0,
    "pin_memory": true,
    "persistent_workers": false,
    "prefetch_factor": 2,
    "optimizer": "adamw",
    "lr": 0.00015,
    "weight_decay": 0.0001,
    "loss": "mse",
    "early_stopping": {
      "enabled": true,
      "monitor": "val_loss",
      "patience": 10,
      "min_delta": 0.0,
      "mode": "min"
    },
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 8,
      "min_lr": 0.000001
    },
    "amp": {
      "enabled": true,
      "dtype": "float16"
    },
    "performance": {
      "cudnn_benchmark": true,
      "tf32": true,
      "compile": false,
      "compile_mode": "default"
    },
    "progress": {
      "enabled": true,
      "stdout": true,
      "jsonl": true,
      "jsonl_name": "metrics_live.jsonl"
    }
  },
  "ml_runs": [],
  "dl_runs": [
    {
      "name": "phase_window_tcn_gas_varweight",
      "model": "phase_window_tcn",
      "modalities": ["slow", "ultrasonic", "fiber_mic"],
      "phase_windows": [
        null,
        {"kind": "phase", "value": "exposure"},
        {"kind": "phase", "value": "recovery"}
      ],
      "loss": {"name": "weighted_component_mse", "weighting": "inverse_train_var"},
      "model_kwargs": {
        "window_count": 3,
        "output_mode": "gas_head",
        "waveform_embedding_dim": 64,
        "acoustic_channels": [16, 32, 64, 64],
        "acoustic_kernel_size": 7,
        "acoustic_dropout": 0.15,
        "slow_hidden_dim": 32,
        "slow_embedding_dim": 64,
        "tcn_channels": [64, 64, 64],
        "tcn_kernel_size": 3,
        "tcn_dropout": 0.25,
        "shared_hidden_dims": [128, 64]
      }
    }
  ]
}
