# Normalize line endings to LF for all text files.
# Prevents CRLF churn when editing on WSL/Windows (repo had a 129-file CRLF incident, 2026-06-02).
* text=auto eol=lf

# Markdown uses two trailing spaces for explicit hard line breaks.
*.md whitespace=-trailing-space

# Explicit binary assets — never normalize.
*.npy binary
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ckpt binary
*.pt binary
*.pth binary

# Frozen evidence is content-addressed; preserve exact bytes on every platform.
gas_information_bench/outputs/archive/freezes/** -text whitespace=-trailing-space
